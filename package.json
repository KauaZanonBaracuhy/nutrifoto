{
  "name": "nutrifoto",
  "version": "0.3.2",
  "description": "Analise nutricional por foto usando IA (OpenRouter)",
  "type": "module",
  "scripts": {
    "build": "node scripts/preparar-publicacao.js",
    "build:web": "node scripts/preparar-publicacao.js",
    "serve": "node servidor/local.js",
    "dev": "node servidor/local.js",
    "dev:cloudflare": "node scripts/wrangler-local.js",
    "build:cloudflare": "wrangler deploy --dry-run --outdir builds/cloudflare",
    "preview:cloudflare": "wrangler versions upload --preview-alias homologacao",
    "deploy:cloudflare": "wrangler deploy",
    "test:cloudflare": "node testes/cloudflare-interface.cjs",
    "test": "node --test testes/*.test.js",
    "test:interface": "node testes/interface.cjs",
    "test:seguranca": "node scripts/verificar-seguranca.js",
    "check": "node scripts/verificar-sintaxe.js",
    "build:android": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/compilar-android.ps1",
    "test:carga": "node testes/carga.cjs",
    "test:postgres": "node --test testes/backend-postgres.test.js testes/operacao-postgres.test.js",
    "test:comercial": "node testes/comercial-interface.cjs",
    "test:pwa": "node testes/pwa-atualizacao.cjs",
    "test:continuidade": "node testes/continuidade-interface.cjs",
    "test:carga:comercial": "node testes/carga-comercial.cjs",
    "test:supabase:local": "node scripts/homologar-supabase-local.js",
    "test:fonte-limpa": "node scripts/verificar-fonte-limpa.js",
    "build:aab": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/compilar-android.ps1",
    "build:windows": "node scripts/compilar-windows.js",
    "test:windows": "node testes/windows-interface.cjs",
    "test:licencas": "node --test testes/licencas.test.js",
    "test:licencas:postgres": "node testes/licencas-postgres.cjs",
    "test:licencas:interface": "node testes/licencas-interface.cjs",
    "test:refinamento": "node testes/refinamento-interface.cjs",
    "test:windows:limpo": "node testes/windows-limpo.cjs",
    "test:windows:portatil": "node testes/windows-portatil.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@fontsource/space-grotesk": "5.3.0",
    "chart.js": "4.5.1",
    "lucide": "1.61.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.58.2",
    "acorn": "8.15.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.4",
    "wrangler": "4.151.3"
  }
}
