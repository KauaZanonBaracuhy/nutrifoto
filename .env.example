# Somente servidor. Copie para .env.local (ignorado). Nunca preencha arquivos públicos.
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=
OPENROUTER_API_KEY=
# Opcional, somente servidor, inteiro 128..1500. Padrão: 1500.
IA_MAX_TOKENS_ANALISE=1500
# Limites são decisões do proprietário. Zero bloqueia consumo por padrão.
IA_QUOTA_GRATIS=0
IA_QUOTA_PAGO=0
IMAGENS_LIMITE_BYTES=0
# Tetos financeiros mensais em USD; zero mantém IA paga desabilitada.
IA_ORCAMENTO_MENSAL_USD=0
IA_ORCAMENTO_USUARIO_MENSAL_USD=0
IA_RESERVA_OPERACAO_USD=0
# Consultar preços vigentes antes de habilitar. USD por milhão de tokens.
IA_PRECO_MAX_ENTRADA_USD_MILHAO=0
IA_PRECO_MAX_SAIDA_USD_MILHAO=0
FOTOS_LIMITE_GRATIS=0
FOTOS_LIMITE_PAGO=0
IMAGENS_LIMITE_GRATIS_BYTES=0
IMAGENS_LIMITE_PAGO_BYTES=0
IA_FOTO_GRATIS=false
IA_FOTO_PAGO=false
SINCRONIZACAO_GRATIS=true
SINCRONIZACAO_PAGO=true
PLANOS_HOMOLOGADOS=false
# Somente sandbox. Chaves de produção são recusadas pelo código.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_MENSAL_ID=
STRIPE_PRICE_ANUAL_ID=
CRON_SECRET=
OPERACAO_SECRET=
METRICAS_HABILITADAS=false
METRICAS_RETENCAO_DIAS=30
RETENCAO_RESULTADOS_DIAS=7
RETENCAO_EVENTOS_DIAS=90
RETENCAO_LIMITES_DIAS=1
ALERTA_P95_MS=2500
# Zero desabilita alerta por bytes; operador define teto de aviso.
ALERTA_STORAGE_BYTES=0
# Proprietário: gerar fora do repositório com scripts/configurar-proprietario.ps1.
# Somente o hash PBKDF2 no segredo do servidor; nunca inserir o código aqui.
PROPRIETARIO_CODIGO_HASH=
PROPRIETARIO_LICENCA_DIAS=30
# Demonstração local: Groq principal, sem fallback pago. Confirmar plano Free no painel antes de preencher a data ISO.
IA_PROVEDOR=groq
GROQ_API_KEY=
GROQ_MODELO=qwen/qwen3.8-27b
GROQ_PLANO=
GROQ_FREE_CONFIRMADO_EM=
GROQ_LIMITE_LOCAL_DIA=20
